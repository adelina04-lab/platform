# ---------------------------------------------------------------------------
# Значения по умолчанию совпадают с docker-compose.yml: для первого запуска
# достаточно `cp .env.example .env` и ничего не менять.
# ---------------------------------------------------------------------------

# --- База данных ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgresql://platform:platform@postgres:5432/platform?schema=public

# --- Очереди (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Партнёрские программы (эпик E0.1) ---
# Приложение поднимается и с пустыми значениями: сборщики цен просто не пойдут
# во внешние API и сообщат, какой переменной не хватает.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
LEVELTRAVEL_TOKEN=
CHEREHAPA_TOKEN=
KIWITAXI_TOKEN=

# --- Аналитика ---
YANDEX_METRIKA_ID=
