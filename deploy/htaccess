# Статический экспорт Next.js на Apache.

# Каталог отдаётся своим index.html — экспорт собран с trailingSlash: true.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Содержимое _next/static неизменяемо: имя файла меняется при каждой сборке,
# поэтому его можно кешировать навсегда.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
